# Plantilla de variables de entorno. Copia a .env (y tus overrides a .env.local).
# Se validan al arrancar (lib/env.ts): si falta o está mal una variable, el servidor no arranca y lo dice.

# ── Aplicación ────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3005
# Obligatorio, mínimo 32 caracteres: npx auth secret
AUTH_SECRET=
# En producción (next start, o detrás de un proxy/balanceador) Auth.js exige confiar en el host;
# sin esto responde UntrustedHost a todo. En `next dev` no hace falta.
# AUTH_TRUST_HOST=true

# ── Base de datos (SQLite) ────────────────────────────────────────
DATABASE_URL=./dev.db

# ── Correo (MailDev en desarrollo: UI en http://localhost:1081) ───
MAIL_HOST=127.0.0.1
MAIL_PORT=1026
MAIL_SECURE=false
MAIL_FROM=noreply@localhost
# Solo si el SMTP pide credenciales
# MAIL_USER=
# MAIL_PASS=

# ── Almacenamiento S3 / MinIO (avatares; opcional) ────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=app-uploads
STORAGE_PUBLIC_URL=http://localhost:9000/app-uploads

# ── Logs (pino): trace | debug | info | warn | error | fatal ──────
# LOG_LEVEL=info

# ── Docker (docker-compose) ───────────────────────────────────────
DOCKER_DATABASE_PORT=11000
DOCKER_DATABASE_NAME=app_db
DOCKER_DATABASE_USERNAME=base
DOCKER_DATABASE_PASSWORD=base
DOCKER_MINIO_API_PORT=9000
DOCKER_MINIO_UI_PORT=9003
DOCKER_MINIO_USERNAME=minioadmin
DOCKER_MINIO_PASSWORD=minioadmin
DOCKER_MAILDEV_SMTP_PORT=1026
DOCKER_MAILDEV_UI_PORT=1081
